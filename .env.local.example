NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only, never expose to client (NOT NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# Key для /api/test-session/cleanup-all. Минимум 32 символа.
ADMIN_CLEANUP_KEY=

# Тестовый контур. Ровно "true" включает /api/mock-login и /api/test-session/*
# и показывает форму тестировщика на /login. Любое другое значение (или пустое)
# — эти роуты отвечают 404.
#
# НЕ включать на проде: mock-login выдаёт рабочую сессию по одному лишь имени
# роли, без пароля. Для питча со сценарием переключения ролей Алексей/Мария
# используйте preview-деплой с TEST_MODE=true.
#
# Server-only — без префикса NEXT_PUBLIC_, чтобы флаг не попал в бандл браузера.
TEST_MODE=

# Пароль аккаунтов тестового контура (демо-пользователи и одноразовые
# пользователи из /api/test-session/create).
#
# Раньше был константой "demo123456" прямо в коде. Репозиторий публичный,
# то есть это был опубликованный пароль: под alexey@demo.local мог зайти
# любой. Пароли всех 346 аккаунтов сменены, константа убрана.
#
# Задавать только в окружении, никогда не коммитить. Значение должно совпадать
# с паролем, выставленным демо-аккаунтам в Supabase. Если переменная не задана,
# роуты тестового контура падают с явной ошибкой — молчаливого отката
# на угадываемый пароль больше нет.
DEMO_AUTH_PASSWORD=
